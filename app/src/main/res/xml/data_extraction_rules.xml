<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never copy encrypted auth material; its Android Keystore key is device-bound. -->
        <exclude domain="sharedpref" path="line_call_secure_session.xml" />
        <!-- Android Auto Backup copies the call-history and contact database to the user's Google backup. -->
        <include domain="database" path="linecall_database" />
    </cloud-backup>
    <device-transfer>
        <!-- Keep secure session preferences off device-to-device transfers as well. -->
        <exclude domain="sharedpref" path="line_call_secure_session.xml" />
        <include domain="database" path="linecall_database" />
    </device-transfer>
</data-extraction-rules>
